{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${fabric_mod_authors}"
    ],
    "contact": {
        "homepage": "https://dimdev.org/",
        "sources": "https://github.com/DimensionalDevelopment/DimDoors",
        "issues": "https://github.com/DimensionalDevelopment/DimDoors/issues"
    },
    "license": "${license}",
    "environment": "*",
    "accessWidener": "dimcore.accesswidener",
    "entrypoints": {
        "main": [
            "org.dimdev.dimcore.DimCoreFabric"
        ],
        "client": [
            "org.dimdev.dimcore.client.DimCoreFabricClient"
        ],
        "mm:early_risers": [
            "org.dimdev.dimcore.client.DimcoreEarlyRiser"
        ]
    },
    "mixins": [
        "dimcore.mixins.json",
        "dimcore.fabric.mixins.json",
        "dimcore-iris.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "fabric-language-kotlin": ">=1.14.1",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
