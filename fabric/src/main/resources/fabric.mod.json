{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "description": "${description}",
    "authors": [
        "${fabric_mod_authors}"
    ],
    "contact": {
        "homepage": "https://dimdev.org/",
        "sources": "https://github.com/DimensionalDevelopment/DimDoors",
        "issues": "https://github.com/DimensionalDevelopment/DimDoors/issues"
    },
    "license": "${license}",
    "icon": "${mod_id}.png",
    "environment": "*",
    "entrypoints": {
        "main": [
            "org.dimdev.dimdoors.DimensionalDoorsFabric"
        ],
        "client": [
            "org.dimdev.dimdoors.client.DimensionalDoorsClientFabric"
        ],
        "fabric-datagen": [
            "org.dimdev.dimdoors.datagen.DatagenInitializer"
        ],
        "mm:early_risers": [
            "org.dimdev.dimdoors.EarlyRiser"
        ],
        "rei_client": [
            "org.dimdev.dimdoors.compat.rei.TesselatingReiCompatClient"
        ],

        "jei_mod_plugin": [
            "org.dimdev.dimdoors.compat.jei.DimDoorsJeiCompatClient"
        ],
        "modmenu": [ "org.dimdev.dimdoors.compat.modmenu.ModMenuCompat" ]
    },
    "mixins": [
        "${mod_id}.mixins.json",
        "${mod_id}.sable_compat.mixins.json",
        "${mod_id}.fabric.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    },
    "custom": {
        "loom:injected_interfaces": {
            "net/minecraft/class_2323": [
                "org/dimdev/dimdoors/block/DoorSoundProvider"
            ],
            "net/minecraft/class_2533": [
                "org/dimdev/dimdoors/block/DoorSoundProvider"
            ]
        }
    }
}
  